generator client {
  provider = "prisma-client-js"
}

// PostgreSQL — point DATABASE_URL at your instance. Workflow/status columns are
// stored as plain strings, so swapping providers needs no other schema changes.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A saved workflow (the portable Workflow JSON, stored as a JSON string).
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  network     String   @default("testnet")
  workflow    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        Run[]
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId    String?
  shares      Share[]
}

/// A sandbox-custodied testnet keypair. Secrets are TESTNET ONLY.
model Wallet {
  id        String   @id @default(cuid())
  publicKey String   @unique
  secret    String
  network   String   @default("testnet")
  label     String?
  funded    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// One execution of a workflow. `status`: pending | running | succeeded | failed.
model Run {
  id         String    @id @default(cuid())
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId  String?
  network    String    @default("testnet")
  workflow   String
  status     String    @default("pending")
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  logs       RunLog[]
}

model RunLog {
  id        String   @id @default(cuid())
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId     String
  nodeId    String
  blockType String
  level     String
  message   String
  txHash    String?
  createdAt DateTime @default(now())

  @@index([runId])
}

/// A future workflow execution. `status`: scheduled | running | done | failed | canceled.
model Schedule {
  id        String    @id @default(cuid())
  name      String
  workflow  String
  runAt     DateTime
  status    String    @default("scheduled")
  lastRunId String?
  createdAt DateTime  @default(now())

  @@index([status, runAt])
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  googleId  String?   @unique
  projects  Project[]
  shares    Share[]
  createdAt DateTime  @default(now())
}

/// A published snapshot of a workflow, shareable via a stable link.
/// `mode`: readonly | fork. The workflow is copied at share time, so later
/// edits to the source project don't change what's already been shared.
model Share {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  network     String   @default("testnet")
  workflow    String
  mode        String   @default("readonly")
  authorName  String?
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId     String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?

  @@index([projectId])
}
