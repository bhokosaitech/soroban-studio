# ── Soroban Studio environment ───────────────────────────────────────────────
# Copy to `.env.local` (dev) or `.env` (prod) and fill in the values.
# Single Next.js process: these cover both the UI and the execution backend.

# PostgreSQL connection string. REQUIRED — the workflow engine, wallets,
# runs, schedules, and projects all persist here.
# Example: postgresql://user:password@localhost:5432/soroban_studio?schema=public
DATABASE_URL=

# Redis for the BullMQ-backed scheduler (durable delayed jobs). OPTIONAL —
# if unset/unreachable, the scheduler falls back to an in-process DB poller.
# Example: redis://127.0.0.1:6379
REDIS_URL=

# Google sign-in — REQUIRED to open /editor and /dashboard (both force auth).
# OAuth 2.0 Web client ID from the Google Cloud console. Add your app origin
# (e.g. http://localhost:3000) to the client's Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Secret used to sign the session (JWT) cookie. Set a long random string in prod.
JWT_SECRET=replace-me-with-a-secure-secret

# DeepSeek API key for the AI Builder (prompt → workflow). OPTIONAL —
# without it, the AI Builder uses a keyless heuristic fallback.
DEEPSEEK_API_KEY=

# Stellar network. Custodial signing is testnet-only by design; leave as testnet.
STELLAR_NETWORK=testnet

# Optional: point the browser at a different API origin. Leave blank to use the
# same-origin Next.js route handlers (the default for the monolith).
# NEXT_PUBLIC_API_URL=
